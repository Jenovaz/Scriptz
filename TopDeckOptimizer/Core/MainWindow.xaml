<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jenovaz 'Top Deck' OS Optimizer"
        Width="1180" Height="780" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0F1115" Foreground="#E6E8EE"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="Panel"   Color="#161920"/>
        <SolidColorBrush x:Key="Card"    Color="#1D212A"/>
        <SolidColorBrush x:Key="CardHi"  Color="#242935"/>
        <SolidColorBrush x:Key="Line"    Color="#2B303C"/>
        <SolidColorBrush x:Key="Muted"   Color="#9AA3B2"/>
        <SolidColorBrush x:Key="Accent"  Color="#F5B942"/>
        <SolidColorBrush x:Key="AccentText" Color="#16130A"/>

        <!-- On/off switch drawn over a CheckBox -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="44" Height="24" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="12" Background="#3A4050"/>
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="#E6E8EE"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#F5B942"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="23,0,0,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#16130A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E6E8EE"/>
            <Setter Property="Background" Value="#242935"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="#343A48" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F5B942"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F5B942"/>
            <Setter Property="Foreground" Value="#16130A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Padding="16,10" Margin="8,2" CornerRadius="6" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D212A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#242935"/>
                                <Setter Property="Foreground" Value="#F5B942"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#C9CED8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnRecommended" Content="Recommended" ToolTip="Switch on every tweak marked as recommended (safe for most PCs)"/>
                    <Button x:Name="BtnUndoAll" Content="Undo everything" ToolTip="Switch off every tweak that is currently applied"/>
                    <Button x:Name="BtnReset" Content="Discard changes" ToolTip="Put the switches back to match what is currently on this PC"/>
                    <Button x:Name="BtnLoadProfile" Content="Load profile"/>
                    <Button x:Name="BtnSaveProfile" Content="Save profile"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="22" FontWeight="Bold">
                        <Run Text="TOP DECK" Foreground="#F5B942"/><Run Text="  OS Optimizer"/>
                    </TextBlock>
                    <TextBlock x:Name="HeaderSub" Foreground="{StaticResource Muted}" Text="by Jenovaz"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body: category list + tweaks -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="12,14,12,6">
                        <TextBox x:Name="SearchBox" Background="#0F1115" Foreground="#E6E8EE" BorderBrush="#343A48"
                                 CaretBrush="#F5B942" Padding="8,6" FontSize="13" VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="SearchHint" Text="Search" Foreground="#6B7385" Margin="11,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>
            <ScrollViewer x:Name="ContentHost" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,18"/>
        </Grid>

        <!-- Log -->
        <Border Grid.Row="2" Background="#0B0D10" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" Foreground="#AEB6C4" BorderThickness="0"
                     FontFamily="Consolas" FontSize="12" Padding="16,10" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkRestorePoint" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0"
                              Foreground="#C9CED8" Content="Create a restore point first"/>
                    <Button x:Name="BtnPreview" Content="Preview changes"/>
                    <Button x:Name="BtnApply" Style="{StaticResource Primary}" Content="Apply"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Text="Starting..."/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
